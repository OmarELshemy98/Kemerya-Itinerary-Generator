# ─── Kemerya Itinerary Generator — environment template ─────────────────────
# Copy this file to `.env.local` and fill in real values. Never commit `.env*`.

# Supabase (public URL + publishable key are client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (DO NOT expose). Used to bypass RLS / service operations.
SUPABASE_SERVICE_ROLE_KEY=

# Default password for the seeded super admin (seed route only).
DEFAULT_ADMIN_PASSWORD=

# MapTiler static map API key (optional — maps are simply skipped when unset).
NEXT_PUBLIC_MAPTILER_API_KEY=